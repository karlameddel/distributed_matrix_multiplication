{
  "seed": 42,
  "sizes": [500, 1000, 2000, 4000],
  "block": 64,

  "baselines": {
    "seq": true,
    "par_threads": [1, 2, 4, 8]
  },

  "strong_scaling": {
    "description": "Fixed n, more members. Every member has 1 executor thread, so p members = p worker threads (comparable with par with p threads).",
    "members": [1, 2, 4, 8],
    "threads_per_member": 1
  },

  "layouts": {
    "description": "Fixed total of 8 worker threads split into members x threads per member, to isolate the cost of separate processes at constant parallelism.",
    "total_threads": 8,
    "members_x_threads": [[1, 8], [2, 4], [4, 2], [8, 1]],
    "sizes": [1000, 4000]
  },

  "limits": { "time_s": 300, "mem_bytes": 4294967296, "costly_s": 30 },

  "java": { "xmx": "4g", "reps": 5, "warmup": 3, "warmup_min_ms": 300, "target_ms": 20 },

  "hazelcast": {
    "version": "5.4.0 (Community Edition)",
    "cluster": "matmul",
    "address": "127.0.0.1:5701",
    "member_xmx": "2g",
    "jvm_args": [
      "--add-modules", "java.se",
      "--add-exports", "java.base/jdk.internal.ref=ALL-UNNAMED",
      "--add-opens", "java.base/java.lang=ALL-UNNAMED",
      "--add-opens", "java.base/sun.nio.ch=ALL-UNNAMED",
      "--add-opens", "java.management/sun.management=ALL-UNNAMED",
      "--add-opens", "jdk.management/com.sun.management.internal=ALL-UNNAMED"
    ],
    "member_start_timeout_s": 60
  },

  "affinity": "none (OS scheduler)",
  "environment": "single laptop: all members and the client run on the same machine (localhost)"
}