<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local cluster: every member runs on this machine and only uses the loopback interface.
  Discovery is TCP/IP on 127.0.0.1 (multicast and auto-detection disabled), so the members
  never try to join other machines of the network.
-->
<hazelcast xmlns="http://www.hazelcast.com/schema/config"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://www.hazelcast.com/schema/config
           http://www.hazelcast.com/schema/config/hazelcast-config-5.4.xsd">

    <cluster-name>matmul</cluster-name>

    <properties>
        <property name="hazelcast.phone.home.enabled">false</property>
        <!-- A member listed without port is searched on 5701, 5702, ... (20 ports; default is only 3) -->
        <property name="hazelcast.tcp.join.port.try.count">20</property>
    </properties>

    <network>
        <!-- First member 5701, the next ones 5702, 5703, ... -->
        <port auto-increment="true" port-count="20">5701</port>
        <join>
            <auto-detection enabled="false"/>
            <multicast enabled="false"/>
            <tcp-ip enabled="true">
                <member>127.0.0.1</member>
            </tcp-ip>
        </join>
        <interfaces enabled="true">
            <interface>127.0.0.1</interface>
        </interfaces>
    </network>

    <!-- Strips of B for the current multiplication. They are temporary and rebuilt every run,
         so no backup copies: a backup would only add extra transfers between members. -->
    <map name="matrices">
        <backup-count>0</backup-count>
        <async-backup-count>0</async-backup-count>
    </map>

    <!-- Threads per member that run StripTasks. WorkerNode overrides it with its 2nd argument. -->
    <executor-service name="matmul">
        <pool-size>1</pool-size>
    </executor-service>
</hazelcast>